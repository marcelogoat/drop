# Modelo de variáveis de ambiente. Copie para um arquivo .env (local) e preencha,
# ou cadastre estas chaves na Vercel (Settings → Environment Variables).
# Não coloque valores reais neste arquivo — ele vai para o Git.

# Gateway de pagamento (Veno) — obrigatório
VENO_API_KEY=
# Opcional (padrão: https://beta.venopayments.com)
VENO_BASE_URL=

# Meta — tokens do CAPI (OPCIONAL: já estão no código; defina só se quiser trocar)
# META_CAPI_TOKEN_1=
# META_CAPI_TOKEN_2=
# META_CAPI_TOKEN_3=

# Resend (e-mail) — obrigatório para enviar e-mails
RESEND_API_KEY=
EMAIL_FROM=Bazari <pedidos@seudominio.com>
EMAIL_REPLY=contato@seudominio.com

# Painel /admin — ADMIN_PASS é obrigatório em produção
ADMIN_USER=admin
ADMIN_PASS=

# Endereço público do site (usado no webhook da Veno e nos links dos e-mails)
SITE_URL=https://bazari-store.vercel.app

# Banco de dados (Upstash Redis) — normalmente injetado pela integração da Vercel
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
